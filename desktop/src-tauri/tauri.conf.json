{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web2AI",
  "version": "0.1.0",
  "identifier": "com.web2ai.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5288",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Web2AI API",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      },
      {
        "label": "pet",
        "title": "Web2AI Pet",
        "url": "index.html",
        "width": 280,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNzA1MzgwMDA0MUJGMkUKUldRdXYwRUFnRk53cWpUU1RuUjFnOElveW1SS1NrRjlGcEdXUnZUQ3dib3hiU2ROSE0wc0hQMFkK",
      "endpoints": [
        "https://github.com/2noScript/web2ai-api/releases/latest/download/latest.json"
      ]
    }
  }
}
